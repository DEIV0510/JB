---
// Colección por tipo de prenda: las categorías salen del catálogo real (no se inventan).
// Tarjeta para las líneas con varios productos; las pequeñas quedan en los filtros.
// Cada tarjeta lleva al catálogo con ese filtro puesto.
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import { CATEGORIAS, PRODUCTOS } from '../lib/catalogo';

const tarjetas = CATEGORIAS.filter((c) => c.tarjeta);
// Ancho de la palabra más larga en em (Archivo 800/116 % en mayúsculas ≈ 0,84 em por letra):
// el nombre se achica con la tarjeta (unidades cqi) y nunca parte una palabra.
const em = (s: string) => (Math.max(...s.split(' ').map((p) => p.length)) * 0.84).toFixed(2);
// «Faldas y shorts» → «FALDAS Y / SHORTS»: la conjunción no queda sola en una línea.
const sinViuda = (s: string) => s.replace(/ (y|e|de) /gi, ' $1 ');
---

<section id="coleccion" class="col" aria-labelledby="col-titulo">
  <div class="contenedor">
    <header class="col__cab">
      <h2 id="col-titulo" class="titular col__titulo" data-lineas>
        <span class="linea" style="--l:0"><span>La</span></span>
        <span class="linea" style="--l:1"><span class="contorno">colección</span></span>
      </h2>
      <p class="col__meta" data-entra>
        <span class="cifra">{PRODUCTOS.length}</span> productos en <span class="cifra">{CATEGORIAS.length}</span> líneas. Elige por dónde empezar.
      </p>
    </header>

    <ul class="col__grid">
      {
        tarjetas.map((c, i) => (
          <li class="col__item" data-entra style={`--i:${i % 4}`}>
            <a class="col__card" href="#catalogo" data-categoria={c.id}>
              <Foto
                id={c.portada.fotos[0]}
                alt=""
                sizes={i === 0 ? '(min-width: 700px) 50vw, 100vw' : '(min-width: 1024px) 25vw, (min-width: 700px) 33vw, 50vw'}
                class="col__foto"
              />
              <span class="col__txt">
                <span class="col__num rotulo cifra">{String(i + 1).padStart(2, '0')}</span>
                <span class="col__nombre titular" style={`--em:${em(sinViuda(c.nombre))}`}>
                  {sinViuda(c.nombre)}
                </span>
                <span class="col__pie rotulo">
                  <span class="cifra">
                    {c.total} {c.total === 1 ? 'producto' : 'productos'}
                  </span>
                  <span class="col__ir">
                    Explorar <Icono nombre="flecha" tam={14} />
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
      <li class="col__item col__item--todo" data-entra style="--i:3">
        <a class="col__todo" href="#catalogo" data-categoria="todo">
          <span class="col__num rotulo cifra">{String(tarjetas.length + 1).padStart(2, '0')}</span>
          <span class="col__nombre titular" style={`--em:${em('catálogo')}`}>
            Todo el <span class="contorno">catálogo</span>
          </span>
          <span class="col__pie rotulo">
            <span class="cifra">{PRODUCTOS.length} productos</span>
            <span class="col__ir">
              Ver todo <Icono nombre="flecha" tam={14} />
            </span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .col {
    padding-block: clamp(72px, 11vw, 140px);
    border-top: 1px solid var(--linea-o);
  }
  .col__cab {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .col__titulo {
    font-size: min(11.6vw, 8.4rem);
    --trazo: 1.5px;
  }
  .col__meta {
    color: var(--gris-o);
    max-width: 32ch;
  }
  .col__meta .cifra {
    color: var(--blanco);
    font-weight: 600;
  }
  @media (min-width: 900px) {
    .col__cab {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .col__meta {
      text-align: right;
      padding-bottom: 0.8em;
    }
  }

  /* Celular: la primera a lo ancho, el resto de a dos, «Todo» a lo ancho. */
  .col__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .col__item:first-child,
  .col__item--todo {
    grid-column: 1 / -1;
  }
  .col__card {
    position: relative;
    display: block;
    height: 100%;
    min-height: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--negro-2);
    isolation: isolate;
  }
  .col__item:first-child .col__card {
    aspect-ratio: 4 / 3;
  }
  .col__card :global(.col__foto) {
    position: absolute;
    inset: 0;
    z-index: -2;
    transition: transform 1.1s var(--ease);
  }
  .col__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(10 10 10 / 0) 38%, rgb(10 10 10 / 0.88) 100%);
  }
  /* Filete doble que se dibuja al pasar el puntero (el trazo del monograma). */
  .col__card::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 4px double var(--blanco);
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease);
    pointer-events: none;
  }
  .col__txt {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 6px;
    padding: 14px;
  }
  .col__num {
    color: var(--gris-o);
    font-size: 0.6875rem;
  }
  .col__card,
  .col__todo {
    container-type: inline-size;
    --pad: 14px;
  }
  .col__nombre {
    --max: 2.3rem;
    font-size: min(var(--max), calc((100cqi - 2 * var(--pad)) / var(--em, 8)));
    line-height: 1;
  }
  .col__item:first-child .col__nombre {
    --max: 4.6rem;
  }
  .col__pie {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    margin-top: 6px;
    font-size: 0.625rem;
    color: var(--blanco-2);
  }
  .col__ir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .col__ir :global(.icono) {
    transition: transform 0.35s var(--ease);
  }

  /* «Todo el catálogo»: bloque tipográfico con el filete doble. */
  .col__todo {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 28px;
    height: 100%;
    min-height: 200px;
    padding: 18px;
    --pad: 18px;
    border: 4px double var(--blanco);
    isolation: isolate;
    transition: color 0.35s var(--ease);
  }
  .col__todo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--blanco);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.45s var(--ease);
  }
  .col__todo .col__nombre {
    --max: 2.6rem;
    --trazo: 1.2px;
  }
  .col__todo .col__pie {
    color: inherit;
  }

  @media (hover: hover) {
    .col__card:hover :global(.col__foto) {
      transform: scale(1.06);
    }
    .col__card:hover::after {
      opacity: 1;
      transform: none;
    }
    .col__card:hover .col__ir :global(.icono),
    .col__todo:hover .col__ir :global(.icono) {
      transform: translateX(4px);
    }
    .col__todo:hover {
      color: var(--negro);
    }
    .col__todo:hover::before {
      transform: scaleY(1);
    }
    .col__todo:hover .contorno {
      -webkit-text-stroke-color: var(--negro);
    }
  }

  /* Tablet: la primera ocupa 2×2. */
  @media (min-width: 700px) {
    .col__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .col__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .col__item:first-child .col__card {
      aspect-ratio: auto;
    }
    .col__item--todo {
      grid-column: span 2;
    }
    .col__txt {
      padding: 20px;
    }
    .col__card {
      --pad: 20px;
    }
    .col__pie {
      font-size: 0.6875rem;
    }
    .col__todo {
      padding: 24px;
      --pad: 24px;
    }
  }
  /* Escritorio: 2×2 + una alta + dos; abajo tres y «Todo». */
  @media (min-width: 1024px) {
    .col__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }
    .col__item:nth-child(2) {
      grid-row: span 2;
    }
    .col__item:nth-child(2) .col__card {
      aspect-ratio: auto;
    }
    .col__item--todo {
      grid-column: auto;
    }
  }
</style>
