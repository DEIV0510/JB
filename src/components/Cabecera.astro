---
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { NAV } from '../lib/nav';
import { REDES, WHATSAPP } from '../lib/contacto';
import { waDetal } from '../lib/whatsapp';

const { base = '' } = Astro.props as { base?: string };
---

<header class="cab" data-cabecera>
  <div class="cab__barra contenedor">
    <a href={`${base}#inicio`} class="cab__logo" aria-label="JB Merch, ir al inicio">
      <Logo alto={38} prioridad decorativo />
    </a>

    <nav class="cab__nav" aria-label="Principal">
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={`${base}${n.href}`}>{n.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="cab__acciones">
      <a class="cab__wa" href={waDetal} target="_blank" rel="noopener" data-wa="cabecera" aria-label="Pedir por WhatsApp">
        <Icono nombre="whatsapp" tam={18} />
        <span>Pedir por WhatsApp</span>
      </a>
      <button class="cab__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-abrir>
        <Icono nombre="menu" tam={22} />
        <span class="sr">Abrir menú</span>
      </button>
    </div>
  </div>
</header>

<div id="menu" class="menu" role="dialog" aria-modal="true" aria-label="Menú" hidden data-menu>
  <div class="menu__top contenedor">
    <Logo alto={38} decorativo />
    <button class="menu__cerrar" type="button" data-menu-cerrar>
      <Icono nombre="cerrar" tam={22} />
      <span class="sr">Cerrar menú</span>
    </button>
  </div>
  <nav class="menu__nav contenedor" aria-label="Menú">
    <ol>
      {
        NAV.map((n, i) => (
          <li style={`--i:${i}`}>
            <a href={`${base}${n.href}`} data-menu-ir>
              <span class="menu__num rotulo cifra">0{i + 1}</span>
              <span class="titular">{n.texto}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__pie contenedor">
    <a class="btn btn--claro btn--ancho" href={waDetal} target="_blank" rel="noopener" data-wa="menu">
      <Icono nombre="whatsapp" tam={20} />
      Escribir al {WHATSAPP.visible}
    </a>
    <ul class="menu__redes">
      {
        REDES.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener" aria-label={`${r.nombre} de JB Merch`}>
              <Icono nombre={r.id} tam={22} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .cab {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: var(--cabecera);
    background: color-mix(in srgb, var(--negro) 0%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      transform 0.45s var(--ease),
      background-color 0.3s,
      border-color 0.3s;
  }
  .cab.is-solida {
    background: color-mix(in srgb, var(--negro) 94%, transparent);
    border-bottom-color: var(--linea-o);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .cab.is-oculta {
    transform: translate3d(0, -100%, 0);
  }
  .cab__barra {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .cab__logo {
    flex: none;
    display: block;
    padding: 6px 0;
  }
  .cab__logo :global(.logo) {
    width: auto;
    height: 38px;
  }
  .cab__nav {
    display: none;
    margin-left: auto;
  }
  .cab__nav ul {
    display: flex;
    gap: clamp(20px, 2.6vw, 40px);
  }
  .cab__nav a {
    position: relative;
    display: block;
    padding: 10px 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gris-o);
    transition: color 0.25s;
  }
  .cab__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.35s var(--ease);
  }
  .cab__nav a:hover,
  .cab__nav a.is-activo {
    color: var(--blanco);
  }
  .cab__nav a:hover::after,
  .cab__nav a.is-activo::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }
  .cab__acciones {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cab__wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--blanco);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .cab__wa:hover {
    background: var(--blanco);
    color: var(--negro);
  }
  .cab__wa span {
    display: none;
  }
  .cab__menu {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -10px;
  }

  @media (min-width: 560px) {
    .cab__wa span {
      display: inline;
    }
  }
  @media (min-width: 1024px) {
    .cab__nav {
      display: block;
    }
    .cab__acciones {
      margin-left: 16px;
    }
    .cab__menu {
      display: none;
    }
  }

  /* ---------- Menú a pantalla completa (celular y tablet) ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: var(--negro);
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.55s var(--ease-io);
  }
  .menu.is-abierto {
    clip-path: inset(0 0 0 0);
  }
  .menu__top {
    flex: none;
    height: var(--cabecera);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--linea-o);
  }
  .menu__top :global(.logo) {
    height: 38px;
    width: auto;
  }
  .menu__cerrar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -10px;
  }
  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: 24px;
  }
  .menu__nav ol {
    width: 100%;
  }
  .menu__nav li {
    border-bottom: 1px solid var(--linea-o);
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease);
  }
  .menu.is-abierto .menu__nav li {
    opacity: 1;
    transform: none;
    transition-delay: calc(180ms + var(--i) * 60ms);
  }
  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
  }
  .menu__nav .titular {
    font-size: clamp(1.9rem, 9vw, 3.6rem);
  }
  .menu__num {
    color: var(--gris-o);
    width: 2.2em;
  }
  .menu__pie {
    flex: none;
    display: grid;
    gap: 20px;
    padding-block: 20px calc(24px + env(safe-area-inset-bottom));
  }
  .menu__redes {
    display: flex;
    gap: 8px;
  }
  .menu__redes a {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--linea-o);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu__nav li {
      transition: none;
    }
  }
</style>
