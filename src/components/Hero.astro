---
// Portada editorial: titular en dos tiempos (lleno / contorno, como el trazo del monograma),
// tres fotos reales del catálogo en composición asimétrica con su referencia y precio,
// y las dos acciones: explorar la colección o pedir por WhatsApp.
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import { COPY } from '../lib/contacto';
import { waDetal } from '../lib/whatsapp';
import { PRODUCTOS, CATEGORIAS, producto, precioTexto } from '../lib/catalogo';
import { SELECCION, HERO_SIZES } from '../lib/seleccion';

const [a, b, c] = SELECCION.hero.map(producto);
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="contenedor hero__grid">
    <h1 id="hero-titulo" class="titular hero__titulo" data-lineas data-hero-texto>
      <span class="linea" style="--l:0"><span>{COPY.titular[0]}</span></span>
      <span class="linea" style="--l:1"><span class="contorno">{COPY.titular[1]}</span></span>
    </h1>

    <div class="hero__fotos">
      <a class="hero__foto hero__foto--a" href={`#p-${a.id}`} data-abrir={a.id} data-parallax="-0.06">
        <Foto id={a.fotos[0]} alt={a.nombre} sizes={HERO_SIZES} prioridad />
        <span class="hero__tag rotulo cifra">
          {a.ref && <span>Ref. {a.ref}</span>}
          {a.precio && <span>{precioTexto(a.precio)}</span>}
        </span>
      </a>
      <a class="hero__foto hero__foto--b" href={`#p-${b.id}`} data-abrir={b.id} data-parallax="0.05">
        <Foto id={b.fotos[0]} alt={b.nombre} sizes="(min-width: 1024px) 20vw, 36vw" />
      </a>
      <a class="hero__foto hero__foto--c" href={`#p-${c.id}`} data-abrir={c.id} data-parallax="0.1">
        <Foto id={c.fotos[0]} alt={c.nombre} sizes="(min-width: 1024px) 16vw, 36vw" />
      </a>
    </div>

    <div class="hero__pie" data-entra style="--i:3">
      <p class="hero__bajada">{COPY.bajada}</p>
      <div class="hero__ctas">
        <a class="btn btn--claro" href="#catalogo">
          Explorar colección <Icono nombre="flecha" tam={18} class="icono--mueve" />
        </a>
        <a class="btn btn--borde" href={waDetal} target="_blank" rel="noopener" data-wa="hero">
          <Icono nombre="whatsapp" tam={20} />
          Comprar por WhatsApp
        </a>
      </div>
    </div>

    <ul class="hero__datos rotulo cifra" data-entra style="--i:4">
      <li><strong>{PRODUCTOS.length}</strong> productos</li>
      <li><strong>{CATEGORIAS.length}</strong> categorías</li>
      <li>Detal <span aria-hidden="true">/</span> por mayor</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--cabecera) + 20px);
    padding-bottom: clamp(40px, 6vw, 72px);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: 10px;
  }
  .hero__titulo {
    grid-column: 1 / -1;
    grid-row: 1;
    position: relative;
    z-index: 2;
    /* «TUS REGLAS.» mide 7,96 em: 11,2vw lo deja en una línea desde 320 px. */
    font-size: min(11.2vw, 9.6rem);
    --trazo: 1.5px;
    pointer-events: none;
  }
  .hero__titulo .linea > span {
    white-space: nowrap;
  }

  .hero__fotos {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: 10px;
    margin-top: 22px;
  }
  .hero__foto {
    position: relative;
    display: block;
    overflow: hidden;
    will-change: transform;
  }
  .hero__foto :global(.foto) {
    position: absolute;
    inset: 0;
  }
  .hero__foto--a {
    grid-column: 1 / 5;
    grid-row: 1 / 3;
    aspect-ratio: 3 / 4;
  }
  .hero__foto--a :global(img) {
    animation: hero-foto 1.6s var(--ease) both;
  }
  @keyframes hero-foto {
    from {
      transform: scale(1.08);
    }
  }
  :global(html.con-intro) .hero__foto--a :global(img) {
    animation-play-state: paused;
  }
  .hero__foto--b {
    grid-column: 5 / 7;
    grid-row: 1;
    aspect-ratio: 3 / 4;
    margin-top: 28%;
  }
  .hero__foto--c {
    grid-column: 5 / 7;
    grid-row: 2;
    aspect-ratio: 4 / 5;
    margin-top: 10px;
    align-self: start;
  }
  /* Marco con filete doble: la línea del monograma. */
  .hero__foto--b::after,
  .hero__foto--c::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 4px double var(--blanco);
    pointer-events: none;
  }
  .hero__tag {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 12px;
    padding: 9px 12px 8px;
    background: var(--negro);
    color: var(--blanco);
    font-size: 0.6875rem;
  }

  .hero__pie {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    gap: 22px;
    margin-top: 30px;
  }
  .hero__bajada {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.45;
    max-width: 30ch;
    color: var(--blanco);
  }
  .hero__ctas {
    display: grid;
    gap: 10px;
  }
  .hero__datos {
    grid-column: 1 / -1;
    grid-row: 4;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--linea-o);
    color: var(--gris-o);
    font-size: 0.6875rem;
  }
  .hero__datos strong {
    color: var(--blanco);
    font-weight: 600;
  }

  @media (min-width: 600px) {
    .hero__ctas {
      grid-template-columns: auto auto;
      justify-content: start;
    }
  }

  /* Escritorio: el titular cruza sobre las fotos y se invierte encima de ellas. */
  @media (min-width: 1024px) {
    .hero {
      min-height: calc(100svh - 56px);
      display: flex;
      align-items: stretch;
      padding-top: calc(var(--cabecera) + 32px);
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto;
      column-gap: 20px;
    }
    .hero__titulo {
      grid-column: 1 / 11;
      grid-row: 1;
      align-self: start;
      margin-top: 4vh;
      font-size: clamp(5rem, 8.4vw, 9.6rem);
      mix-blend-mode: difference;
      --trazo: 2px;
    }
    .hero__fotos {
      grid-column: 6 / 13;
      grid-row: 1 / 4;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      column-gap: 20px;
      margin-top: 0;
      align-self: stretch;
      align-content: start;
    }
    .hero__foto--a {
      grid-column: 2 / 6;
      grid-row: 1 / 3;
      margin-top: 8vh;
      aspect-ratio: 4 / 5;
    }
    /* El titular se invierte encima de esta foto: se encuadra desde abajo para que cruce solo
       la prenda (blanco y negro) y no los ganchos de color de arriba. */
    .hero__foto--a :global(.foto) {
      inset: auto 0 0 0;
      height: 118%;
    }
    .hero__foto--a :global(img) {
      object-position: 50% 100%;
    }
    .hero__foto--b {
      grid-column: 6 / 8;
      grid-row: 1;
      margin-top: 30%;
    }
    .hero__foto--c {
      grid-column: 1 / 3;
      grid-row: 2;
      margin-top: 0;
      align-self: end;
      margin-bottom: -12%;
      z-index: 1;
    }
    .hero__pie {
      grid-column: 1 / 6;
      grid-row: 2;
      align-self: end;
      margin-top: 0;
    }
    .hero__ctas {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
    .hero__datos {
      grid-column: 1 / 6;
      grid-row: 3;
    }
  }
</style>
